<?xml version="1.0"?>
<configuration>
	<connectionStrings>
		<add
		  name="OrgManageDB"
		  connectionString="Data Source=(LocalDB)\MSSQLLocalDB;AttachDbFilename=|DataDirectory|\OrgManageDB.mdf;Integrated Security=True"
		  providerName="System.Data.SqlClient"
		/>
	</connectionStrings>
  <appSettings>
    <!-- ✅✅✅ 安全提示：生产环境请设置环境变量，避免凭据硬编码 ✅✅✅
         部署到服务器后，请在 IIS 应用程序池或系统环境中设置：
         setx ORGMAIL_ACCOUNT "your_email@qq.com" /M
         setx ORGMAIL_AUTHCODE "your_auth_code" /M
         代码会优先读取环境变量，不存在时才回退到下面配置 -->
    <!-- 邮件凭证（请替换为你自己的邮箱和授权码，或使用环境变量） -->
    <add key="MailAccount" value="your_email@qq.com"/>
    <add key="MailAuthCode" value="your_auth_code"/>
    <add key="SiteTitle" value="高校组织综合线上管理平台"/>
    <!-- 文件上传路径 -->
    <add key="UploadPath" value="~/Uploads/"/>
    <add key="MaxUploadSize" value="5242880"/>
    <!-- 5MB -->
  </appSettings>
  <system.web>
    <!-- ✅ debug=false：生产环境必须关闭，否则暴露完整堆栈信息 -->
    <compilation debug="false" targetFramework="4.7.2"/>
    <httpRuntime targetFramework="4.7.2" maxRequestLength="10240"/>
    <!-- 表单认证 -->
    <authentication mode="Forms">
      <forms name=".OrgAuth" loginUrl="~/Account/Login.aspx" timeout="20" protection="All" cookieless="UseCookies" slidingExpiration="true"/>
    </authentication>
    <httpCookies httpOnlyCookies="true" sameSite="Strict" />
    <authorization>
      <allow users="*"/>
    </authorization>
    <!-- ✅ session timeout 改为30分钟（更安全），并开启会话固定防护 -->
    <sessionState mode="InProc" timeout="30" cookieSameSite="Strict"/>
    <globalization culture="zh-CN" uiCulture="zh-CN" requestEncoding="UTF-8" responseEncoding="UTF-8"/>
    <!-- ✅ customErrors 开启，防止生产环境暴露详细错误 -->
    <customErrors mode="Off" defaultRedirect="~/Error.aspx">
      <error statusCode="404" redirect="~/Error.aspx?code=404"/>
      <error statusCode="500" redirect="~/Error.aspx?code=500"/>
    </customErrors>
    <pages>
      <namespaces/>
    </pages>
  </system.web>
  <system.webServer>
    <urlCompression doStaticCompression="true" doDynamicCompression="true"/>
    <modules runAllManagedModulesForAllRequests="true"/>
    <staticContent>
      <remove fileExtension=".woff2"/>
      <mimeMap fileExtension=".woff2" mimeType="font/woff2"/>
    </staticContent>
  </system.webServer>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral"/>
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0"/>
      </dependentAssembly>
    </assemblyBinding>
  </runtime>
</configuration>
